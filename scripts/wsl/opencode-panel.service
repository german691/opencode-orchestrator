[Unit]
Description=Panel en vivo de opencode-orchestrator (solo lectura)
After=network.target

[Service]
Type=simple
WorkingDirectory=/mnt/c/Users/tecnologia/Documents/GitHub/opencode-orchestrator
Environment=ORQ_PANEL_PORT=7480
Environment=ORQ_PANEL_HOST=127.0.0.1
ExecStart=/usr/bin/node src/panel.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
